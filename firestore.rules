rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reusable auth check functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User data isolation: All collections under /users/{userId} belong strictly to that user
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Social & Squads
    match /squads/{squadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || request.resource.data.members[request.auth.uid] != null);
    }

    // Geolocation Clubs
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Anonymized Cohort Benchmarks (Read-only for authenticated users, written by Cloud Functions)
    match /cohortBenchmarks/{cohortKey} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Creator & Coach Marketplace listings
    match /marketplace/{listingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // Deny anything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
