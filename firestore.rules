rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reusable auth check functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to ensure clients cannot tamper with server-verified subscription fields
    function notModifyingSubscriptionFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'subscriptionTier',
        'subscriptionStatus',
        'subscriptionExpiresAt',
        'serverVerificationHash',
        'willRenew'
      ]);
    }

    // User data isolation: All collections under /users/{userId} belong strictly to that user
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['subscriptionTier']) || request.resource.data.subscriptionTier == 'free');
      allow update: if isOwner(userId) && notModifyingSubscriptionFields();
      allow delete: if isOwner(userId);
      
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Social & Squads
    match /squads/{squadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || request.resource.data.members[request.auth.uid] != null);
    }

    // Geolocation Clubs & Accountability Communities
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /discussions/{threadId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    // Public Sangha Activity Feed
    match /publicFeed/{feedId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Anonymized Cohort Benchmarks (Read-only for authenticated users, written by Cloud Functions)
    match /cohortBenchmarks/{cohortKey} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Leaderboards (Read-only for authenticated users, compiled by Cloud Functions)
    match /leaderboards/{leaderboardKey} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Creator & Coach Marketplace listings
    match /marketplace/{listingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // Deny anything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
