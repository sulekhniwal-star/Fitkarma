# Copy to wrangler.toml and fill in the database_id values from
# `wrangler d1 create fitkarma-db-staging` / `fitkarma-db-production`.
# Secrets are NEVER put here — set them with `wrangler secret put <NAME> --env <env>`.

name = "fitkarma-api"
main = "src/index.ts"
compatibility_date = "2026-01-01"

# ─── Local dev (wrangler dev, no --env flag) ───────────────────────────
[[d1_databases]]
binding = "DB"
database_name = "fitkarma-db-dev"
database_id = "<local-dev-database-id>"

[triggers]
crons = ["*/15 * * * *"]

# ─── Staging ────────────────────────────────────────────────────────────
[env.staging]
name = "fitkarma-api-staging"
vars = { ENVIRONMENT = "staging" }

[[env.staging.d1_databases]]
binding = "DB"
database_name = "fitkarma-db-staging"
database_id = "<staging-database-id>"

[env.staging.triggers]
crons = ["*/15 * * * *"]

# ─── Production ─────────────────────────────────────────────────────────
[env.production]
name = "fitkarma-api"
vars = { ENVIRONMENT = "production" }

[[env.production.d1_databases]]
binding = "DB"
database_name = "fitkarma-db-production"
database_id = "<production-database-id>"

[env.production.triggers]
crons = ["*/15 * * * *"]

# Secrets required per environment (set once, not committed):
#   wrangler secret put GROQ_API_KEY --env staging
#   wrangler secret put GOOGLE_OAUTH_CLIENT_ID --env staging
#   wrangler secret put JWT_SIGNING_SECRET --env staging
#   wrangler secret put GROQ_API_KEY --env production
#   wrangler secret put GOOGLE_OAUTH_CLIENT_ID --env production
#   wrangler secret put JWT_SIGNING_SECRET --env production
# Use a DIFFERENT JWT_SIGNING_SECRET per environment so a staging-issued
# token can never authenticate against production.
